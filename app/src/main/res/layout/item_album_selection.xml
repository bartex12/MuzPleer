<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="72dp">

    <!-- Обложка альбома -->
    <ImageView
        android:id="@+id/albumArtSelection"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:scaleType="centerCrop"
        android:padding="4dp"
        android:contentDescription="@string/album_art_description"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:src="@drawable/placeholder2" />

    <!-- Название альбома -->
    <TextView
        android:id="@+id/albumTitleSelection"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/albumArtSelection"
        app:layout_constraintTop_toTopOf="@+id/albumArtSelection"
        tools:text="Название альбома" />

    <TextView
        android:id="@+id/albumArtistSelection"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/white"
        android:textAppearance="@style/TextAppearance.AppCompat.Caption"
        app:layout_constraintStart_toEndOf="@id/albumArtSelection"
        app:layout_constraintTop_toBottomOf="@+id/albumTitleSelection"
        app:layout_constraintEnd_toStartOf="@+id/tracksCountSelection"
        tools:text="Исполнитель" />

    <TextView
        android:id="@+id/tracksCountSelection"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:textAppearance="@style/TextAppearance.AppCompat.Caption"
        android:textColor="@color/white"
        app:layout_constraintBottom_toBottomOf="@+id/albumArtistSelection"
        app:layout_constraintStart_toEndOf="@id/albumArtistSelection"
        app:layout_constraintTop_toTopOf="@+id/albumArtistSelection"
        tools:text="12 треков" />

    <!-- Divider -->
    <View
        android:id="@+id/view"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:background="@color/colorPrimaryBlack"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
       />
</androidx.constraintlayout.widget.ConstraintLayout>