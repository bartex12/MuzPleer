<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingVertical="8dp"
    android:background="@drawable/popup_menu_bg"
    android:elevation="8dp">

    <TextView
        android:id="@+id/itemAddSongToPlaylist"
        style="@style/PopupMenuItem"
        android:text="Добавить песни в плейлист"
        android:drawablePadding="12dp"
        app:drawableStartCompat="@drawable/outline_playlist_add_24"
        app:drawableTint="@color/white"/>

    <View style="@style/PopupMenuDivider" />

    <TextView
        android:id="@+id/itemRemoveFromPlaylist"
        style="@style/PopupMenuItem"
        android:text="Удалить песни из плейлиста"
        android:drawablePadding="12dp"
        app:drawableStartCompat="@drawable/outline_playlist_remove_24"
        app:drawableTint="@color/white"/>

    <View style="@style/PopupMenuDivider" />

    <TextView
        android:id="@+id/itemChangeCoverPlaylist"
        style="@style/PopupMenuItem"
        android:text="Изменить обложку плейлиста "
        android:drawablePadding="12dp"
        app:drawableStartCompat="@drawable/outline_edit_square_24"
        app:drawableTint="@color/white"/>

    <View style="@style/PopupMenuDivider" />

    <TextView
        android:id="@+id/itemRenamePlaylist"
        style="@style/PopupMenuItem"
        android:text="Переименовать плейлист"
        android:drawablePadding="12dp"
        app:drawableStartCompat="@drawable/outline_edit_line_24"
        app:drawableTint="@color/white"/>

    <View style="@style/PopupMenuDivider" />

    <TextView
        android:id="@+id/itemDeletePlaylist"
        style="@style/PopupMenuItem"
        android:text="Удалить плейлист"
        android:drawablePadding="12dp"
        app:drawableStartCompat="@drawable/outline_delete_forever_24"
        app:drawableTint="@color/white"/>

</LinearLayout>