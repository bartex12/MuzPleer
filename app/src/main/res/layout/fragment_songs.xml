<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Полоска со значками под тулбаром: белая линия 1dp, цвет и высота как у вкладок; прячется значком глаза в тулбаре -->
    <LinearLayout
        android:id="@+id/songsStrip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/white" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="?attr/appPanelLight"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/stripGoTo"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="К треку"
                android:focusable="true">
                <ImageView
                android:id="@+id/stripGoToIcon"
                android:scaleType="center"
                    android:layout_width="match_parent"
                android:layout_height="match_parent"
                    android:paddingTop="2dp"
                    android:paddingBottom="14dp"
                android:importantForAccessibility="no"
                android:src="@drawable/outline_flag_24"
                app:tint="@color/white" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_marginBottom="3dp"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="К треку"
                    android:textColor="@color/white"
                    android:tag="stripLabel"
                    android:textSize="10sp" />
            </FrameLayout>
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <ImageButton
                android:id="@+id/stripShuffle"
                    android:layout_width="match_parent"
                android:layout_height="match_parent"
                    android:paddingTop="2dp"
                    android:paddingBottom="14dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Случайный порядок"
                android:src="@drawable/icons8_data_white_24"
                app:tint="@color/white" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_marginBottom="3dp"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="Перемешивание"
                    android:textColor="@color/white"
                    android:tag="stripLabel"
                    android:textSize="10sp" />
            </FrameLayout>
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <ImageButton
                android:id="@+id/stripSort"
                    android:layout_width="match_parent"
                android:layout_height="match_parent"
                    android:paddingTop="2dp"
                    android:paddingBottom="14dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Сортировка"
                android:src="@drawable/ic_sort_24"
                app:tint="@color/white" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_marginBottom="3dp"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="Сортировка"
                    android:textColor="@color/white"
                    android:tag="stripLabel"
                    android:textSize="10sp" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/localRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/sortPanel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/songsStrip"
        tools:listitem="@layout/item_music"/>

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imageHolder3" />

    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="36dp"
        android:text="У вас пока нет музыкальных треков"
        android:textColor="@color/white"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imageHolder3"
        tools:visibility="visible"
        />

    <ImageView
        android:id="@+id/imageHolder3"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:scaleType="centerCrop"
        android:src="@drawable/answer300"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.3" />

    <!-- Панель сортировки над вкладками: высота по содержимому -->
    <com.example.muzpleer.ui.local.view.SortPanelView
        android:id="@+id/sortPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/appPanel"
        android:paddingHorizontal="16dp"
        android:paddingBottom="4dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>