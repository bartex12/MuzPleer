<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/dialog_card_bg">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Вернуться к изображению по умолчанию?"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Слева текущая картинка, справа та, что будет возвращена -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivRestoreCurrent"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/muz_player3" />

        <!-- Жирная стрелка: текущая картинка меняется на стандартную -->
        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginHorizontal="6dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_arrow_bold_right_24" />

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/muz_player3" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRestoreYes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/item_list_effects_stroke"
            android:text="Да"
            android:textColor="@color/white"
            app:backgroundTint="@null" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRestoreCancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/item_list_effects_stroke"
            android:text="Отмена"
            android:textColor="@color/white"
            app:backgroundTint="@null" />
    </LinearLayout>
</LinearLayout>
