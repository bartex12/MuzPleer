<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/item_list_effects_revers">

    <!-- Заголовок -->
    <TextView
        android:id="@+id/tvRenameTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Переименовать плейлист"
        android:textAppearance="@style/TextAppearance.AppCompat.Headline"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:layout_marginBottom="24dp" />

    <!-- Поле ввода -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/rename_text_layout"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Новое название"
        android:theme="@style/WhiteTextInputLayoutOverlay"
        app:counterEnabled="false"
        app:helperText="Введите новое название плейлиста"
        app:helperTextTextColor="@android:color/white"
        app:errorEnabled="true">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/rename_edit_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapSentences"
            android:maxLines="1"
            android:maxLength="50"
            android:textColor="@color/white"
            android:imeOptions="actionDone" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Кнопки -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal"
        android:weightSum="2">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRenameCancel"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="Отмена"
            android:textColor="@color/white"
           />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRenameSave"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Сохранить"
            android:textColor="@color/white"
            app:backgroundTint="@color/colorPrimary"
            app:cornerRadius="8dp" />

    </LinearLayout>

</LinearLayout>