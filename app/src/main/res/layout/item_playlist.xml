<?xml version="1.0" encoding="utf-8"?>
<com.example.muzpleer.ui.view.NowPlayingRow xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    xmlns:tools="http://schemas.android.com/tools"
    >

    <ImageView
        android:id="@+id/playlistArtwork"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:scaleType="centerCrop"
        android:src="@drawable/placeholder2"
        android:padding="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/playlistTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textSize="16sp"
        android:textStyle="bold"
        android:text="Название плейлиста может быть длинным и даже очень длинным и занимать две строки"
        android:textColor="@color/white"
        app:layout_constraintEnd_toStartOf="@id/eqPlaylist"
        app:layout_constraintStart_toEndOf="@id/playlistArtwork"
        app:layout_constraintTop_toTopOf="@id/playlistArtwork"/>

    <TextView
        android:id="@+id/playlistSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/whisper"
        android:text="Количество треков и общее время"
        android:textAppearance="@style/TextAppearance.AppCompat.Caption"
        app:layout_constraintEnd_toStartOf="@id/eqPlaylist"
        app:layout_constraintStart_toEndOf="@id/playlistArtwork"
        app:layout_constraintTop_toBottomOf="@id/playlistTitle"/>

    <!-- Divider -->
    <View
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:background="?attr/appPanel"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/playlist_menu_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        android:scaleType="centerCrop"
        android:src="@drawable/squere_vertical_menu_icon_white_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Эквалайзер: виден, когда играет трек из этого элемента -->
    <com.example.muzpleer.ui.view.EqualizerView
        android:id="@+id/eqPlaylist"
        android:layout_width="22dp"
        android:layout_height="20dp"
        android:layout_marginEnd="8dp"
        android:tag="nowPlayingEqualizer"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/playlist_dragHandle"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/playlist_dragHandle"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="8dp"
        android:visibility="gone"
        android:src="@drawable/ic_drag_handle_24"
        android:tint="?attr/appAccent"
        app:layout_constraintBottom_toBottomOf="@id/playlistArtwork"
        app:layout_constraintEnd_toStartOf="@id/playlist_menu_button"
        app:layout_constraintTop_toTopOf="@id/playlistArtwork"
        tools:visibility="visible"/>

</com.example.muzpleer.ui.view.NowPlayingRow>