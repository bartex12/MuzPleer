<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Полоска со значками под тулбаром: белая линия 1dp, цвет и высота как у вкладок; прячется значком глаза в тулбаре -->
    <LinearLayout
        android:id="@+id/favoriteStrip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/white" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="?attr/appPanelLight"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/stripGoTo"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="К треку"
                android:src="@drawable/outline_flag_24"
                app:tint="@color/white" />
            <ImageButton
                android:id="@+id/stripShuffle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Случайный порядок"
                android:src="@drawable/icons8_data_white_24"
                app:tint="@color/white" />
            <ImageButton
                android:id="@+id/stripEdit"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Редактировать порядок"
                android:src="@drawable/baseline_edit_note_24"
                app:tint="@color/white" />
            <ImageButton
                android:id="@+id/stripSort"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Сортировка"
                android:src="@drawable/ic_sort_24"
                app:tint="@color/white" />
        </LinearLayout>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/favoriteRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/favoriteStrip"
        app:layout_constraintBottom_toTopOf="@id/sortPanel"
        tools:listitem="@layout/item_music" />

    <ImageView
        android:id="@+id/emptyImageViewFavorite"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_marginTop="24dp"
        android:scaleType="centerCrop"
        android:visibility="gone"
        android:src="@drawable/answer300"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/favoriteStrip"
        tools:visibility="visible"/>

        <TextView
            android:id="@+id/favoriteEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text = "Здесь пока нет ни одного трека"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginTop="18dp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/emptyImageViewFavorite"
            tools:visibility="visible"/>

    <!-- Панель сортировки над вкладками: высота по содержимому; прячется значком сортировки, свайпом вниз по заголовку -->
    <LinearLayout
        android:id="@+id/sortPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/appPanel"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="4dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/sortHeader"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:text="@string/sort_by"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <RadioButton
            android:id="@+id/sortNone"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:buttonTint="?attr/appAccent"
            android:checked="true"
            android:paddingStart="8dp"
            android:text="@string/sort_none"
            android:textColor="@color/white"
            android:textSize="15sp" />

        <RadioButton
            android:id="@+id/sortTitle"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:buttonTint="?attr/appAccent"
            android:paddingStart="8dp"
            android:text="@string/sort_title"
            android:textColor="@color/white"
            android:textSize="15sp" />

        <RadioButton
            android:id="@+id/sortAlbum"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:buttonTint="?attr/appAccent"
            android:paddingStart="8dp"
            android:text="@string/sort_album"
            android:textColor="@color/white"
            android:textSize="15sp" />

        <RadioButton
            android:id="@+id/sortArtist"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:buttonTint="?attr/appAccent"
            android:paddingStart="8dp"
            android:text="@string/sort_artist"
            android:textColor="@color/white"
            android:textSize="15sp" />

        <RadioButton
            android:id="@+id/sortDuration"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:buttonTint="?attr/appAccent"
            android:paddingStart="8dp"
            android:text="@string/sort_duration"
            android:textColor="@color/white"
            android:textSize="15sp" />

        <RadioButton
            android:id="@+id/sortDate"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:buttonTint="?attr/appAccent"
            android:paddingStart="8dp"
            android:text="@string/sort_date_added"
            android:textColor="@color/white"
            android:textSize="15sp" />

        <CheckBox
            android:id="@+id/sortAscending"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:buttonTint="?attr/appAccent"
            android:checked="true"
            android:paddingStart="8dp"
            android:text="@string/sort_ascending"
            android:textColor="@color/white"
            android:textSize="15sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>