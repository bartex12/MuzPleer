<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/dialog_card_bg">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/sleep_timer_dialog_title"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvTimerRemaining"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvTimerEnds"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        android:textColor="@color/secondary_text"
        android:textSize="13sp"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTimerCancel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/item_list_effects_stroke"
            android:text="Отменить таймер"
            android:textColor="@color/white"
            app:backgroundTint="@null"
            android:visibility="gone" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTimer15"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/item_list_effects_stroke"
            android:text="15 минут"
            android:textColor="@color/white"
            app:backgroundTint="@null" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTimer30"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/item_list_effects_stroke"
            android:text="30 минут"
            android:textColor="@color/white"
            app:backgroundTint="@null" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTimer45"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/item_list_effects_stroke"
            android:text="45 минут"
            android:textColor="@color/white"
            app:backgroundTint="@null" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTimer60"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/item_list_effects_stroke"
            android:text="60 минут"
            android:textColor="@color/white"
            app:backgroundTint="@null" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTimerCustom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/item_list_effects_stroke"
            android:text="Выбрать время"
            android:textColor="@color/white"
            app:backgroundTint="@null" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
