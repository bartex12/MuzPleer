<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingVertical="8dp"
    android:background="@drawable/popup_menu_bg"
    android:elevation="8dp">

    <TextView
        android:id="@+id/itemAddToFavorites"
        style="@style/PopupMenuItem"
        android:text="Добавить в избранное"
        android:drawablePadding="12dp"
        app:drawableStartCompat="@drawable/baseline_favorite_24"
        app:drawableTint="@color/white"/>

    <TextView
        android:id="@+id/itemRemoveFromFavorites"
        style="@style/PopupMenuItem"
        android:text="Удалить из избранного"
        android:drawablePadding="12dp"
        app:drawableStartCompat="@drawable/baseline_favorite_border_24"
        app:drawableTint="@color/white"/>

    <View style="@style/PopupMenuDivider" />

    <TextView
        android:id="@+id/itemAddToPlaylist"
        style="@style/PopupMenuItem"
        android:text="Добавить в плейлист"
        android:drawablePadding="12dp"
        app:drawableStartCompat="@drawable/outline_playlist_add_24"
        app:drawableTint="@color/white"/>

    <View style="@style/PopupMenuDivider" />

    <TextView
        android:id="@+id/itemChangeCover"
        style="@style/PopupMenuItem"
        android:text="Изменить обложку"
        android:drawablePadding="12dp"
        app:drawableStartCompat="@drawable/outline_edit_square_24"
        app:drawableTint="@color/white"/>

    <View style="@style/PopupMenuDivider" />

    <TextView
        android:id="@+id/itemEditSongInfo"
        style="@style/PopupMenuItem"
        android:text="Изменить информацию о песне"
        android:drawablePadding="12dp"
        app:drawableStartCompat="@drawable/outline_edit_note_24"
        app:drawableTint="@color/white"/>

    <View style="@style/PopupMenuDivider" />

    <TextView
        android:id="@+id/itemSend"
        style="@style/PopupMenuItem"
        android:text="Поделиться"
        android:drawablePadding="12dp"
        app:drawableStartCompat="@drawable/outline_share_24"
        app:drawableTint="@color/white"/>

    <View style="@style/PopupMenuDivider" />

    <TextView
        android:id="@+id/itemSongInfo"
        style="@style/PopupMenuItem"
        android:text="О песне"
        android:drawablePadding="12dp"
        app:drawableStartCompat="@drawable/outline_info_24"
        app:drawableTint="@color/white"/>

</LinearLayout>