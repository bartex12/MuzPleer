<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="8dp"
    android:background="@drawable/popup_menu_bg"
    android:elevation="8dp">

    <TextView
        android:id="@+id/itemQueueAdd"
        style="@style/PopupMenuItem"
        android:text="Добавить треки в плейлист"
        android:drawablePadding="12dp"
        app:drawableStartCompat="@drawable/outline_playlist_add_24"
        app:drawableTint="@color/white"/>

    <View style="@style/PopupMenuDivider" />

    <TextView
        android:id="@+id/itemQueueAddByTime"
        style="@style/PopupMenuItem"
        android:text="Добавить треки по времени"
        android:drawablePadding="12dp"
        app:drawableStartCompat="@drawable/playlist_add_check_24px"
        app:drawableTint="@color/white"/>

    <View
        android:id="@+id/dividerQueueRemove"
        style="@style/PopupMenuDivider" />

    <TextView
        android:id="@+id/itemQueueRemove"
        style="@style/PopupMenuItem"
        android:text="Удалить треки из плейлиста"
        android:drawablePadding="12dp"
        app:drawableStartCompat="@drawable/outline_playlist_remove_24"
        app:drawableTint="@color/white"/>
</LinearLayout>
