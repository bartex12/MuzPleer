<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Фон на случай, если картинка не загрузится -->
    <item>
        <shape>
            <solid android:color="@color/colorPrimaryBlack" />
        </shape>
    </item>

    <!-- Та же картинка и тот же способ масштабирования (fill), что и в ImageView
         на activity_splash.xml: иначе при замене фона окна на layout картинка "прыгает" -->
    <item>
        <bitmap
            android:src="@drawable/muz_player_800_1600"
            android:gravity="fill" />
    </item>
</layer-list>
